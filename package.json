  "bugs": {
    "url": "https://github.com/uarch-solutions/cdk-github-runner-switch/issues"
  },
  "keywords": [
    "aws-cdk",
    "cdk",
    "construct",
    "github-actions",
    "self-hosted-runner",
    "github-runner",
    "ec2-spot",
    "graviton",
    "arm64",
    "ci",
    "cost-optimization"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "lambda",
    "scripts",
    "README.md",
    "README.pt-BR.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
