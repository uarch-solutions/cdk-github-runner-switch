    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk-lib": "^2.271.0",
    "constructs": "^10.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
